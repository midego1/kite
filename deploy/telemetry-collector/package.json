{
	"name": "kite-telemetry-collector",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --config wrangler.jsonc",
		"deploy": "wrangler deploy --config wrangler.jsonc",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
		"typecheck": "tsc --noEmit",
		"test": "node --test ../../tests/telemetry-collector.test.mjs"
	},
	"devDependencies": {
		"wrangler": "^4.151.0",
		"@cloudflare/workers-types": "^5.20261016.1",
		"typescript": "^5.7.4"
	},
	"engines": {
		"node": ">=22.21.0"
	}
}
