{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kite",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"keep_vars": true,
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kite",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
	],
	"triggers": {
		"crons": ["0 2 * * *", "*/5 * * * *"],
	},
	"analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "kite_metrics" }],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
		{
			"name": "AGENT_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 },
		},
		{
			"name": "BOOKING_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 5, "period": 60 },
		},
		{
			"name": "REMOTE_IMAGE_RATE_LIMIT",
			"namespace_id": "1004",
			"simple": { "limit": 600, "period": 60 },
		},
		{
			"name": "DRIVE_LINK_RATE_LIMIT",
			"namespace_id": "1005",
			"simple": { "limit": 60, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
		// Sampled traces show per-request D1/R2/fetch spans without tracing every request.
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1,
		},
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": false,
		},
	],
	"ai": { "binding": "AI", "remote": true },
	// Search by meaning (docs/specs/semantic-search.md): the index and its `mailboxId` metadata index are created
	// once, by hand, before the release that adds this binding is deployed (docs/deployment.md); never from a
	// Mission. A Worker whose configuration binds an index that does not exist fails to deploy.
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "kite-messages",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kite",
			"database_id": "9889a007-57f9-48b8-aceb-76a9be137915",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "kite-raw",
			"preview_bucket_name": "kite-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "kite-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "kite-outbound",
			},
			{
				"binding": "AGENT_QUEUE",
				"queue": "kite-agent",
			},
		],
		"consumers": [
			// One message per invocation: a batch runs its messages one after another in one invocation, sharing its CPU
			// time and memory, so one very large message could end the invocation and send the other mail of its batch
			// to a retry it did not need. Queues bills per message, not per batch. At most 10 invocations at once: unset,
			// Queues scales a backlog to 250, and a connected account's first sync hands over 200 messages per run, each
			// writing to the one D1 database (docs/operations.md).
			{
				"queue": "kite-inbound",
				"max_batch_size": 1,
				"max_concurrency": 10,
				"max_retries": 3,
			},
			// One message per invocation, for the same reason as kite-inbound above: it mixes sends, backups,
			// restores and storage migrations, so a slow one must not retry the rest of its batch with it. The
			// same concurrency cap too, since its jobs also write to the one D1 database.
			{
				"queue": "kite-outbound",
				"max_batch_size": 1,
				"max_concurrency": 10,
				"max_retries": 3,
			},
			{
				"queue": "kite-agent",
				"max_batch_size": 1,
				"max_retries": 3,
			},
		],
	},
	// Worker Previews (`npx wrangler preview`, or Workers Builds preview builds of non-production branches) do not
	// inherit any binding. These point at the production database, bucket and queues on purpose, so a branch can be
	// tried with the real accounts, domains and mail. Production keeps the routes, email handler, crons and queue
	// consumers, so work a Preview queues (scheduled sends, imports) runs on production. REALTIME gets its own namespace in
	// every Preview, so live updates from newly delivered mail do not reach it. Never apply migrations from a Preview:
	// they would change the production database.
	"previews": {
		"services": [
			{
				"binding": "WORKER_SELF_REFERENCE",
				"service": "kite",
			},
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "REALTIME",
					"class_name": "RealtimeHub",
				},
			],
		},
		"images": { "binding": "IMAGES" },
		"ai": { "binding": "AI" },
		"vectorize": [
			{
				"binding": "VECTORIZE",
				"index_name": "kite-messages",
			},
		],
		"version_metadata": { "binding": "CF_VERSION_METADATA" },
		"analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "kite_metrics_preview" }],
		"ratelimits": [
			{
				"name": "LOGIN_RATE_LIMIT",
				"namespace_id": "1101",
				"simple": { "limit": 20, "period": 60 },
			},
			{
				"name": "AGENT_RATE_LIMIT",
				"namespace_id": "1102",
				"simple": { "limit": 120, "period": 60 },
			},
			{
				"name": "BOOKING_RATE_LIMIT",
				"namespace_id": "1103",
				"simple": { "limit": 5, "period": 60 },
			},
			{
				"name": "REMOTE_IMAGE_RATE_LIMIT",
				"namespace_id": "1104",
				"simple": { "limit": 600, "period": 60 },
			},
			{
				"name": "DRIVE_LINK_RATE_LIMIT",
				"namespace_id": "1105",
				"simple": { "limit": 60, "period": 60 },
			},
		],
		"send_email": [{ "name": "EMAIL" }],
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "kite",
				"database_id": "9889a007-57f9-48b8-aceb-76a9be137915",
			},
		],
		"r2_buckets": [
			{
				"binding": "BUCKET",
				"bucket_name": "kite-raw",
			},
		],
		"queues": {
			"producers": [
				{
					"binding": "INBOUND_QUEUE",
					"queue": "kite-inbound",
				},
				{
					"binding": "OUTBOUND_QUEUE",
					"queue": "kite-outbound",
				},
				{
					"binding": "AGENT_QUEUE",
					"queue": "kite-agent",
				},
			],
		},
	},
}
