{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kite-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-20",
	// The app's default collector (DEFAULT_TELEMETRY_URL in src/lib/telemetry/telemetry-utils.ts). A Worker custom
	// domain creates a proxied DNS record for exactly this name and its certificate, which takes precedence over the
	// `*.midego.net` wildcard record. The midego.net zone must be on the deploying Cloudflare account.
	"routes": [{ "pattern": "kite-telemetry.midego.net", "custom_domain": true }],
	// Only the custom domain answers; no *.workers.dev address and no preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	// Create the database with `npx wrangler d1 create kite-telemetry` and paste its id here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kite-telemetry",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	// DELETE /v1/installs/<id>: at most 30 erasure requests a minute across all callers (per Cloudflare location).
	// The namespace id is any number unique among this account's rate limiters.
	"ratelimits": [{ "name": "ERASE_RATE_LIMIT", "namespace_id": "4710", "simple": { "limit": 30, "period": 60 } }],
	// STATS_TOKEN is a secret: `npx wrangler secret put STATS_TOKEN`; never commit it. Without it GET /v1/stats answers 401.
	// Once a day: daily rows older than 90 days are rolled up into aggregates without install ids and deleted.
	"triggers": { "crons": ["30 4 * * *"] },
	// Off so request metadata (IP address, user agent) does not end up in Workers Logs.
	"observability": { "enabled": false }
}
