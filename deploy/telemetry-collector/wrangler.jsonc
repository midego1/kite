{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kite-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-20",
	// The app's default collector (DEFAULT_TELEMETRY_URL in src/lib/telemetry/telemetry-utils.ts). A custom domain
	// creates the DNS record and certificate; the midego.net zone must be on the deploying Cloudflare account.
	"routes": [{ "pattern": "kite-telemetry.midego.net", "custom_domain": true }],
	// Only the custom domain answers; no *.workers.dev address.
	"workers_dev": false,
	// Create the database with `npx wrangler d1 create kite-telemetry` and paste its id here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kite-telemetry",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	// Set with `npx wrangler secret put STATS_TOKEN`; never commit it. Without it GET /v1/stats answers 401.
	"vars": { "DAILY_RETENTION_DAYS": "400" },
	// Removes `daily` rows older than DAILY_RETENTION_DAYS once a day.
	"triggers": { "crons": ["30 4 * * *"] },
	// Off so request metadata (IP address, user agent) does not end up in Workers Logs.
	"observability": { "enabled": false }
}
