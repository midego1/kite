# First-run setup token. Production refuses to create the first admin without it;
# open /setup?setup_token=<value> or enter it on the setup page. Development stays open unless set,
# so remove this line from your local .dev.vars if you do not want to enter it. Listed here
# uncommented so the Deploy to Cloudflare button asks for it. Production refuses this example
# value and anything shorter than 16 characters; use e.g. `openssl rand -hex 32`.
SETUP_TOKEN=a-long-random-string

# Encrypts provider keys and webhook secrets stored in D1 (AES-GCM). Listed here uncommented so the
# Deploy to Cloudflare button asks for it; replace the example value with a long random string, for
# example from `openssl rand -hex 32`. First-run setup in production refuses the example value and
# anything shorter than 16 characters. Existing plaintext values keep working and are encrypted the
# next time they are saved. Keep a copy: losing or changing it makes the encrypted values unreadable.
APP_ENCRYPTION_KEY=a-long-random-string

# Preferred: scoped API token.
# This is an app runtime token, not the Cloudflare deploy/build token.
CF_TOKEN=your_api_token_with_zone_email_permissions

# Legacy Global API Key alternative. Use this only instead of CF_TOKEN.
# CF_EMAIL=you@example.com
# CF_API_KEY=your_global_api_key

# The Worker uses the AI binding in wrangler.jsonc. Override its chat/draft model if needed.
# AI_MODEL=@cf/moonshotai/kimi-k2.5

# Optional: send and receive through Resend or Amazon SES instead of Cloudflare.
# These can also be entered in Admin > Domains; values saved there take precedence.
# RESEND_API_KEY=re_...
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_REGION=us-east-1
# Public HTTPS address. Receiving through Resend or SES needs it, and password
# reset links are only sent when it is set. Add it after the first deploy, once you know the address;
# the setup page shows the exact value to use.
# APP_URL=https://mail.example.com

# Optional: most messages one user may send per rolling hour and day (defaults 100 and 500; 0 removes
# a limit). Applies to the composer, the API, JMAP, MCP approvals, invitations and automatic replies.
# SEND_LIMIT_PER_HOUR=100
# SEND_LIMIT_PER_DAY=500

# Optional: a free abuse.ch Auth-Key. Links, link hosts and attachment hashes (never files) of
# incoming mail that already looks risky are then checked against URLhaus and ThreatFox.
# ABUSE_CH_AUTH_KEY works too; URLHAUS_AUTH_KEY wins when both are set. The owner can instead save
# a key in Admin > General; a secret set here takes precedence. See docs/spam-protection.md.
# URLHAUS_AUTH_KEY=your_abuse_ch_auth_key

# Development and tests only: lets the alert webhook (Admin > Alerts) post over http
# to a loopback address such as http://127.0.0.1:3290/hook. Ignored in production.
# ALERT_WEBHOOK_ALLOW_INSECURE=1

# Optional: apply pending database migrations without opening Admin settings. A new
# version deploys before its migrations run, and until an admin applies them new mail
# may not appear. With this set, Kite applies them the first time it notices them, after
# saving the same safety backup the "Apply now" button saves. Leave it unset to keep
# migrations manual.
# AUTO_APPLY_MIGRATIONS=1

# Optional: pseudonymous usage statistics are on by default; the first-run setup explains
# them with a switch, and an existing install's owner gets a notice 14 days before the first
# report. KITE_TELEMETRY=0 (or false, off, no) turns them off for the deployment: nothing is
# sent and the owner cannot turn them on (only off); no value turns them on. Reports go to
# https://kite-telemetry.midego.net, run by Michiel de Gooijer (midego) on Cloudflare;
# KITE_TELEMETRY_URL replaces that address (https only), and an empty value sends nothing.
# See docs/privacy.md#usage-statistics.
# KITE_TELEMETRY=0
